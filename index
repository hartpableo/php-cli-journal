#!/usr/bin/env php
<?php

use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Exception\ExceptionInterface;
use Symfony\Component\Console\SingleCommandApplication;
use Symfony\Component\Console\Style\SymfonyStyle;
use Symfony\Component\Process\Process;

if (php_sapi_name() !== 'cli') {
  exit(1);
}

require_once __DIR__ . '/vendor/autoload.php';
require_once __DIR__ . '/env.php';

const BASE_ACTION_CHOICES = [
  'View all entries',
  'Create new entry',
  'Exit',
];

const INDEX_ACTION_CHOICES = [
  'View an entry (enter ID)',
  'Create new entry',
  'Filter entries',
  'Back',
];

const SINGLE_ENTRY_ACTIONS = [
  'Edit this entry',
  'Delete this entry',
  'Back to entries index',
  'Back to home'
];

try {
  new SingleCommandApplication()
    ->setName('php-cli-journal')
    ->setCode(function (SymfonyStyle $io): int {
      // Connect to SQLite DB
      $db = new PDO('sqlite:' . __DIR__ . '/db/journal.db');
      $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
      $db->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);

      // Create "entry" table if not yet exists
      $db->exec("
        CREATE TABLE IF NOT EXISTS entry (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          content TEXT NOT NULL,
          created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
          updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
        );
      ");

      $io->title('PHP CLI JOURNAL');

      $totalEntries = $db->query("SELECT COUNT(*) FROM entry")->fetchColumn();
      $io->writeln('Total entries: ' . $totalEntries);

      $run = TRUE;
      while ($run) {
        $action = $io->choice(
          'What do you want to do?',
          BASE_ACTION_CHOICES,
          BASE_ACTION_CHOICES[0]
        );

        switch ($action) {
          case BASE_ACTION_CHOICES[0]:
            $io->section("All Entries");

            $entries = $db->query("SELECT * FROM entry")->fetchAll();

            if (empty($entries)) {
              $io->comment("No entries yet...");
              break;
            }

            $io->text("Total: {$totalEntries}");
            $io->table(
              ['ID', 'Content', 'Created at'],
              array_map(function (array $entry) {
                return [
                  $entry['id'],
                  substr($entry['content'], 0, 25) . '...',
                  convertToMyTimezone($entry['created_at'])
                ];
              }, array_values($entries))
            );

            // Actions: view an entry (enter entry ID to view), filter by id range or date range
            $runEntriesIndexPrompt = TRUE;
            while ($runEntriesIndexPrompt) {
              $indexAction = $io->choice(
                'What do you want to do?',
                INDEX_ACTION_CHOICES,
                INDEX_ACTION_CHOICES[0]
              );

              switch ($indexAction) {
                case INDEX_ACTION_CHOICES[0]:
                  $id = $io->ask('Enter entry ID');
                  $entry = $db->query("SELECT * FROM entry WHERE id = {$id}")->fetch();
                  if (empty($entry)) {
                    $io->error('Entry not found.');
                  }
                  else {
                    // Actions: edit, delete, back to index, back to home
                    $runSingleEntryPrompt = TRUE;
                    while ($runSingleEntryPrompt) {
                      $io->title("Entry {$entry['id']}");
                      $io->text(sprintf(
                        'Created at: %s',
                        convertToMyTimezone($entry['created_at'])
                      ));
                      $io->text(sprintf(
                        'Last modified: %s',
                        convertToMyTimezone($entry['updated_at'])
                      ));
                      $io->block(htmlspecialchars_decode($entry['content']));

                      $singleEntryPromptAction = $io->choice(
                        'What do you want to do?',
                        INDEX_ACTION_CHOICES,
                        INDEX_ACTION_CHOICES[0]
                      );

                      switch ($singleEntryPromptAction) {
                        case INDEX_ACTION_CHOICES[0]:
                          $io->section("Now editing entry {$entry['id']}");
                          $newContent = entryText($entry['content']);
                          if ($newContent !== $entry['content']) {
                            $updated = $db
                              ->prepare("UPDATE entry SET content = :content, updated_at = :updated_at WHERE id = :id")
                              ->execute([
                                ':content' => $newContent,
                                ':id' => $entry['id'],
                                ':updated_at' => new DateTimeImmutable(
                                  'now',
                                  new DateTimeZone('UTC')
                                )->format('Y-m-d H:i:s')
                              ]);

                            if (!$updated) {
                              $io->error('Entry was not updated.');
                            }
                            else {
                              $io->success('Entry has been updated.');
                            }
                          }
                          break;

                        case INDEX_ACTION_CHOICES[1]:
                          if ($io->confirm("Are you sure you want to delete this entry?")) {
                            $deleted = $db
                              ->prepare("DELETE FROM entry WHERE id = :id")
                              ->execute(['id' => $entry['id']]);
                            if ($deleted) {
                              $io->info("Entry {$entry['id']} deleted.");
                              $runSingleEntryPrompt = FALSE;
                            }
                            else {
                              $io->info('Entry was not deleted.');
                            }
                          }
                          break;

                        case INDEX_ACTION_CHOICES[2]:
                          $runSingleEntryPrompt = FALSE;
                          break;

                        case INDEX_ACTION_CHOICES[3]:
                          $runSingleEntryPrompt = FALSE;
                          $runEntriesIndexPrompt = FALSE;
                          break;
                      }
                    }
                  }
                  break;

                case INDEX_ACTION_CHOICES[3]:
                  $runEntriesIndexPrompt = FALSE;
                  break;
              }
            }
            // @todo: support pagination (10 per page)
            break;

          case BASE_ACTION_CHOICES[1]:
            $io->section("Create New Entry");

            $entryBody = entryText();

            if (!empty($entryBody)) {
              $stmt = $db->prepare("
                  INSERT INTO entry (content, created_at)
                  VALUES (:content, :created_at)
                ");
              $dtNow = new DateTimeImmutable(
                'now',
                new DateTimeZone('UTC')
              )->format('Y-m-d H:i:s');
              $inserted = $stmt->execute([
                'content' => $entryBody,
                'created_at' => $dtNow,
              ]);

              if (!$inserted) {
                $io->error('Something went wrong with saving your entry. Please try again!');
              }
              else {
                $io->success(sprintf(
                  "Entry saved at %s!",
                  convertToMyTimezone($dtNow)
                ));
                $io->text(trim(substr($entryBody, 0, 15)) . '...');
              }
            }
            break;

          case BASE_ACTION_CHOICES[2]:
            $io->text("Good bye.");
            $run = FALSE;
            break;
        }
      }

      return Command::SUCCESS;
    })
    ->run();
} catch (ExceptionInterface $e) {
  echo $e->getMessage();
  exit(1);
}


// Convert to desired timezone
function convertToMyTimezone(
  string $time,
  string $format = 'Y-m-d H:i:s'
): string {
  $date = DateTime::createFromFormat($format, $time, new DateTimeZone('UTC'));
  $date->setTimezone(new DateTimeZone(MY_TZ));
  return $date->format('Y-m-d g:i A (e)');
}

// Text editor
function entryText($default = ""): FALSE|string {
  $tmpFile = tempnam(sys_get_temp_dir(), 'journal_entry_');

  if ($default !== '') {
    file_put_contents($tmpFile, htmlspecialchars_decode($default));
  }

  $editor = PHP_OS_FAMILY === 'Windows' ? 'notepad' : 'nano';

  // Launch the editor and attach it to the terminal's TTY
  $process = new Process([$editor, $tmpFile]);
  $process->setTty(Process::isTtySupported());
  $process->mustRun();

  $content = file_get_contents($tmpFile);
  unlink($tmpFile);

  return trim(htmlspecialchars($content));
}